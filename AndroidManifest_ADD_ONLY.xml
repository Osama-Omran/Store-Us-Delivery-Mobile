<!-- Add directly under <manifest> in android/app/src/main/AndroidManifest.xml: -->
<queries>
    <package android:name="ru.a402d.rawbtprinter" />
</queries>

<!-- Add INSIDE the existing <application> in that same file: -->
<provider
    android:name=".StoreUsRawBtFileProvider"
    android:authorities="${applicationId}.storeus_rawbt_app_files"
    android:exported="false"
    android:grantUriPermissions="true">
    <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/storeus_rawbt_app_file_paths" />
</provider>
